# Alpaca paper trading. The judged account is created on kickoff day and never reset.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_PAPER=true
# Which of Alpaca's toolsets the agent may see at all.
ALPACA_TOOLSETS=account,trading,assets,options-data,stock-data,news

# How many turns, intents and refusals the page carries. The record is a week
# long by the end; a page is read in one screen.
RECORD_SHOWS=50

# Policy gateway. Every broker call goes through it; the agent never holds broker keys.
# Left empty, the stack points the agents at the envelope stand-in beside them,
# which answers what each is allowed to do and nothing else.
GATEWAY_URL=
# One token per agent, and they must differ: the token is what decides whose
# limits apply, so two agents sharing one would be one agent as far as the rules
# are concerned. Any opaque string will do.
GATEWAY_TOKEN=
GATEWAY_NEAR_TOKEN=
# Which token belongs to which caller, as token=identity pairs. The identities are
# the names in policy/envelope.yaml, and the tokens are the two above.
ENVELOPE_CALLERS=
# Куда идут ЗАЯВКИ сессии. Всегда шлюз, и никогда сервер брокера напрямую: шлюз -
# единственное, что может отклонить заявку, и единственная запись о том, что она
# была. Точку входа сессия получает от entrypoint, который пишет этот адрес в её
# собственную настройку MCP.
BROKER_MCP_URL=
# Куда идут ЧТЕНИЯ харнесса: цены, часы, счёт, цепочки. Пусто - туда же, куда
# заявки. Разделять их понадобилось 27 августа: шлюз держал наш клиент открытым,
# get_clock не отвечал полторы минуты, и за ним вставали скринер, писец счёта и
# писец волатильности - молча. Заявки при этом обязаны идти через шлюз: он
# единственный, кто может их отклонить и кто записывает, что они были.
# Имя службы отличается в разработке и в бою (alpaca-mcp-agent-1 против alpaca-mcp),
# поэтому здесь пусто: значение принадлежит развёртыванию.
HARNESS_BROKER_MCP_URL=
HARNESS_BROKER_MCP_TOKEN=
# То же самое для второго счёта. Отдельные переменные, потому что счёт у него
# свой: один сервер Alpaca обслуживает один счёт.
HARNESS_BROKER_NEAR_MCP_URL=
HARNESS_BROKER_NEAR_MCP_TOKEN=


# Where the PAGE reads the broker. Always the gateway, never the broker's own
# server: what makes the page's credential unable to send an order is the
# gateway refusing it, so this address is what keeps a read-only surface
# read-only.
PAGE_MCP_URL=

# Скринер: что он просматривает и что считает годным к показу. Разбор - docs/screener.md.
#
# Список должен совпадать с тем, что разрешает конверт (policy/envelope.yaml) - сейчас
# это два места с одним фактом, и они уже расходились. Перечисление через запятую.
SCREENER_UNDERLYINGS=SPY,QQQ,IWM,DIA,AAPL,NVDA,TSLA,META,MSFT,AMZN
# Такт прохода. Возвращён на пять минут 26 августа после ЖИВОГО отказа 429:
# лимит счёта 200 запросов в минуту делится между проходом и торговыми сессиями,
# а сессии в тот же час стали просыпаться вдвое чаще (окно входа 20м -> 10м).
# Проход стоит около 290 запросов; на трёхминутном такте это ~97 в минуту, почти
# половина лимита, и сессиям не хватило.
# Сокращать такт снова можно только после ЗАМЕРА того, сколько тратят сессии, -
# иначе это обмен свежести списка на отказы у тех, ради кого список существует.
SCREENER_EVERY=5m
# Сколько запросов в минуту забирает СЕБЕ проход. Предел брокера - 200 в минуту на
# бесплатном плане, и он общий на счёт: проход делит его с торговыми сессиями.
# Поэтому здесь не 180. Замерено 27 августа при 180: в минуты прохода 133 отказа
# 429 из 187 запросов, следом 159 из 188 - сессия входа не прочитала ни новости,
# ни цену, а защита дважды не увидела позиций и сообщила, что шлюз недоступен.
# Число подбирается замером отказов, а не рассуждением.
SCREENER_PER_MINUTE=100
# Насколько далеко проданный страйк от цены, в процентах.
SCREENER_NEAREST=0.1
SCREENER_FURTHEST=3.0
# Календарных дней вперёд. Семь, а не пять: до пяти ТОРГОВЫХ дней растягиваются на семь
# календарных через выходные, и меньшее число прячет дальний край.
SCREENER_EXPIRATIONS=7
# Кредит к риску: ниже первого не окупает даже хороший проход, выше второго - сломанная
# котировка, а не щедрость.
SCREENER_LEAST_PAID=8
SCREENER_MOST_PAID=100
# Насколько вероятно проданный страйк уйдёт в деньги. Контракт без дельты в список не
# попадает: в день истечения брокер её не считает, а это и есть день, когда страйк
# пересекается чаще всего.
#
# Число обязано совпадать с потолком, объявленным в декларации, и это не украшение.
# Сессия ранжирует по edge_points из read_candidates, то есть выбирает ИЗ СПИСКА
# скринера. Порог здесь ниже объявленного означает, что объявленный не работает:
# декларация разрешает 0,45, а сессии никогда не показывают ничего дальше порога.
# Так и было до 27 августа - в декларации 0,45, в скринере 0,25.
# Сколько бумаг спрашиваются ОДНОВРЕМЕННО. Пусто или 0 - по одной, как было.
# Замерено 27 августа на живых вызовах через шлюз: один ответ цепочки занимает
# около 2,3 секунды (SPY 3,4, AAPL 2,1, XLF 2,0), и половина этого - мегабайт
# ответа, а не соединение. По одной 284 бумаги проходятся ОДИННАДЦАТЬ минут и
# тратят 26 запросов в минуту из разрешённых брокером 180. Останавливать проход
# должен ограничитель брокера, а не форма нашего цикла.
SCREENER_WORKERS=6
SCREENER_MOST_DELTA=0.45
# Граница бессмыслицы, а не способ выбирать: половина стоимости прохода вычитается
# из кредита до всех измерений, поэтому дорогая конструкция сама показывает низкое
# преимущество. Ставить широко. При 20 один проход выбросил 833 конструкции против
# 96 у следующего фильтра.
SCREENER_DEAREST=150
# Насколько конструкция платит БОЛЬШЕ, чем ей надо выжить, в процентных пунктах:
# вероятность уцелеть (1 - |дельта|) минус безубыточная вероятность, заложенная в цене.
# Считается по кредиту ПОСЛЕ вычета половины стоимости прохода, поэтому цена входа
# входит в саму меру, а не стоит отдельным порогом рядом.
# Пусто или ноль - проверка выключена. Значение выбираем по замерам, а не на глаз;
# счётчик отброшенного как раз для этого.
SCREENER_LEAST_EDGE=-3.0


# Whose option volatility is recorded all day, and how often. Two of the three
# entry rules compare today's volatility with its own past, and the broker sells
# no such history - this is where it comes from.
VOLATILITY_UNDERLYINGS=SPY,QQQ,IWM,AVGO
VOLATILITY_EVERY=5m

# How often the account's value is written down, how many orders the page
# carries, and how far back its equity line is drawn.
ACCOUNT_EVERY=5m

# How the execution ladder walks an unfilled structure: how often it steps, how
# far one step moves the limit, and how long an order may wait before it is
# cancelled. Empty interval means orders rest where the session placed them.
# EXECUTION_EVERY is both the step and the rest: an order sits at each price this
# long before the next move, so the book has time to take it.
EXECUTION_EVERY=45s
EXECUTION_STEP=0.01
EXECUTION_PATIENCE=8m
ORDERS_SHOWN=25
HISTORY_DAYS=14

DECLARATION=
APP_PORT=8080

# The chat this session posts to. Leave the token empty and the agent is offered
# no way to post at all.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
# Whose messages reach a session. Empty means nobody: an open channel into a
# trading agent is not a default.
TELEGRAM_ALLOW_USER_IDS=

# The host's Go module cache, mounted into the database tier: that network has
# no route out, so `go test` there downloads nothing. `go env GOMODCACHE`.
GOMODCACHE=

# The host directory holding the Codex login (auth.json), mounted read-only. The
# agent container runs as AGENT_UID so it can read that file; it must match the
# user that owns it on the host.
CODEX_AUTH_DIR=${HOME}/.codex
AGENT_UID=1000
# Empty leaves the agent's own configured model.
AGENT_CALL_TIMEOUT=180s
TURN_LIMIT=6m
SAY_EVERY=25s
# The model a trading session runs on, and how hard it thinks. A session that
# only reads the news names a cheaper model in the declaration.
AGENT_MODEL=
AGENT_REASONING_EFFORT=high

# Database
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents
POSTGRES_DB=agents
IMAGE_TAG=latest
# Куда агент ходит наружу. Пусто - интернет-шлюз рядом со стеком. Стенд на своей
# машине этой сети не видит и называет свой путь, например http://egress:8888.
OUTBOUND_PROXY=
BROKER_MCP_TOKEN=
BROKER_NEAR_MCP_URL=
BROKER_NEAR_MCP_TOKEN=
# The read-only surface: an observer credential that cannot place an order.
PAGE_MCP_TOKEN=
# The model through the policy gateway. Path shape: /byok/{agent}/{instance}/v1
MODEL_GATEWAY_URL=
MODEL_NEAR_GATEWAY_URL=

# A teammate's own Alpaca account. Their keys, sent privately and never to a
# shared chat. With them set, start the server and enable its gateway endpoint:
#   docker compose --profile tikhon up -d alpaca-mcp-tikhon
ALPACA_TIKHON_API_KEY_ID=
ALPACA_TIKHON_API_SECRET_KEY=

# Хосты, которые нужны ИМЕННО этому развёртыванию, регулярными выражениями через
# перевод строки. Сюда попадает адрес шлюза, когда он не на этой машине.
# Домен, по которому судья открывает страницу, и почта для сертификата. Нужны
# только развёрнутому стенду: локально страница отвечает по своему порту.
DASHBOARD_HOST=
ACME_EMAIL=

EXTRA_ALLOWED_HOSTS=
