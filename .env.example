# Alpaca paper trading. The judged account is created on kickoff day and never reset.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_PAPER=true
# Which of Alpaca's toolsets the agent may see at all.
ALPACA_TOOLSETS=account,trading,assets,options-data,stock-data,index-data,corporate-actions,news

# Policy gateway. Every broker call goes through it; the agent never holds broker keys.
GATEWAY_URL=
GATEWAY_TOKEN=
# Development only: the broker's server without the gateway in front of it.
BROKER_MCP_URL=

# Which roles this process runs: harness, api, mcp. The harness needs DECLARATION.
ROLES=api,mcp
DECLARATION=
APP_PORT=8080

# The chat this session posts to. Leave the token empty and the agent is offered
# no way to post at all.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
# Whose messages reach a session. Empty means nobody: an open channel into a
# trading agent is not a default.
TELEGRAM_ALLOW_USER_IDS=

# The host directory holding the Codex login (auth.json), mounted read-only. The
# agent container runs as AGENT_UID so it can read that file; it must match the
# user that owns it on the host.
CODEX_AUTH_DIR=${HOME}/.codex
AGENT_UID=1000
# Empty leaves the agent's own configured model.
AGENT_MODEL=

# Database
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents
POSTGRES_DB=agents
POSTGRES_PORT=5436
IMAGE_TAG=latest
